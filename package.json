{
  "name": "tinker-town-factory",
  "version": "0.6.0",
  "private": true,
  "description": "A cozy endless idle factory game. HTML5 + Capacitor (Android).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.js\"",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:icons": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#1f2a44\" --iconBackgroundColorDark \"#1f2a44\" --splashBackgroundColor \"#1f2a44\" --splashBackgroundColorDark \"#1f2a44\""
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2"
  }
}
